---
// Navbar.astro — Barra de Navegación Cinematográfica Táctica
---

<header class="nav-hud">
  <div class="app-container nav-hud-inner">
    
    <!-- Logo Brand Lockup -->
    <a href="#" class="flex items-center gap-3 no-underline group flex-shrink-0">
      <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-[var(--bg-card)] shadow-[var(--neu-flat-sm)] border border-[var(--border-subtle)] flex items-center justify-center text-[var(--primary)] transition-transform duration-200 group-hover:scale-105">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
      </div>
      <div>
        <div class="text-base sm:text-lg font-black tracking-tight text-[var(--text-main)] font-['Outfit'] flex items-center gap-2">
          Play<span class="text-[var(--primary)]">Match</span>
          <span class="text-[9px] sm:text-[10px] tracking-wider px-1.5 py-0.5 rounded font-mono font-bold bg-[var(--bg-sunken)] border border-[var(--border-subtle)] text-[var(--accent-mint)]">
            VOXTI LABS
          </span>
        </div>
      </div>
    </a>

    <!-- Pestañas de Navegación HUD (Visibles desde pantallas medianas) -->
    <nav class="hidden md:flex items-center gap-1.5 bg-[var(--bg-sunken)] p-1.5 rounded-2xl shadow-[var(--neu-pressed-sm)] border border-[var(--border-subtle)]">
      <a href="#playersSection" class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 text-[var(--text-main)] bg-[var(--bg-card)] shadow-[var(--neu-flat-xs)]">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
        </svg>
        Compañeros
      </a>
      <a href="#tourneysSection" class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 text-[var(--text-muted)] hover:text-[var(--text-main)]">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="8 21 12 17 16 21"></polyline>
          <line x1="12" y1="17" x2="12" y2="21"></line>
          <path d="M7 4H4a2 2 0 0 0-2 2v2a5 5 0 0 0 5 5h1"></path>
          <path d="M17 4h3a2 2 0 0 1 2 2v2a5 5 0 0 1-5 5h-1"></path>
          <rect x="7" y="2" width="10" height="11" rx="2"></rect>
        </svg>
        Torneos &amp; Llaves
      </a>
      <a href="#aboutSection" class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 text-[var(--text-muted)] hover:text-[var(--text-main)]">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        Arquitectura
      </a>
    </nav>

    <!-- Indicadores de Telemetría Táctica & Acciones -->
    <div class="flex items-center gap-2.5 sm:gap-3 flex-shrink-0">
      
      <!-- Latencia Telemetría con Visualizador de Frecuencia de Audio -->
      <div class="hidden sm:flex items-center gap-2.5 telemetry-indicator">
        <span class="indicator-pulse-dot"></span>
        <span>SCL-1: <strong class="text-[var(--accent-mint)]">8ms</strong></span>
        <div class="sound-visualizer ml-1" title="Canal de voz activo">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </div>
      </div>

      <!-- Conmutador Tema Día / Noche -->
      <button class="neu-icon-btn" id="themeToggleBtn" aria-label="Cambiar modo visual" title="Alternar modo visual">
        <span id="themeIconContainer">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </span>
      </button>

      <!-- Botón Perfil -->
      <button class="neu-btn neu-btn-primary neu-btn-sm text-xs" id="profileOpenBtn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        <span class="hidden sm:inline">Mi Perfil</span>
        <span class="sm:hidden">Perfil</span>
      </button>

      <!-- Botón Cerrar Sesión -->
      <button class="neu-icon-btn" id="logoutBtn" aria-label="Cerrar Sesión" title="Cerrar Sesión (Volver al Login)">
        <svg class="w-4 h-4 text-[var(--accent-red)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
      </button>
    </div>

  </div>
</header>

<script is:inline>
  document.getElementById('themeToggleBtn')?.addEventListener('click', () => {
    const cur = document.documentElement.getAttribute('data-mode') || 'noche';
    const next = cur === 'noche' ? 'dia' : 'noche';
    document.documentElement.setAttribute('data-mode', next);
    localStorage.setItem('pm_theme_mode', next);
    const icon = document.getElementById('themeIconContainer');
    if (icon) {
      icon.innerHTML = next === 'noche' 
        ? `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>`
        : `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line></svg>`;
    }
  });

  document.getElementById('profileOpenBtn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-player-profile', { detail: { isMyProfile: true } }));
  });

  document.getElementById('logoutBtn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('logout-user'));
  });
</script>
