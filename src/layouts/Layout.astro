---
import '../styles/cinematic.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "PlayMatch — Emparejamiento Social & Gestión de Torneos",
  description = "Plataforma de alta ingeniería y diseño cinematográfico para emparejamiento social y gestión de torneos competitivos."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" data-mode="noche">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='25' fill='%2307080A'/><polygon points='35,25 75,50 35,75' fill='%23FF2A4D'/></svg>" />
</head>
<body>

  <!-- Capas Atmosféricas Cinematográficas Aceleradas por Hardware -->
  <div class="cinema-viewport-layers" aria-hidden="true">
    <!-- Video de Cinemática Gamer en Loop Continuo -->
    <div class="cinema-video-bg-container">
      <video
        class="cinema-video-bg"
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        poster="/images/gamer_login_art.jpg"
      >
        <source src="/videos/game_cinematic_bg.mp4" type="video/mp4" />
        <source src="https://cdn.akamai.steamstatic.com/steam/apps/256972298/movie480.mp4" type="video/mp4" />
      </video>
      <div class="cinema-video-overlay"></div>
    </div>

    <div class="cinema-vignette"></div>
    <div class="cinema-tactical-grid"></div>
    <div class="radar-sweep-beam"></div>
    <div class="cinematic-embers-layer">
      <div class="cinematic-ember e1"></div>
      <div class="cinematic-ember e2"></div>
      <div class="cinematic-ember e3"></div>
      <div class="cinematic-ember e4"></div>
      <div class="cinematic-ember e5"></div>
    </div>
    <div class="anamorphic-flare"></div>
    <div class="anamorphic-glow-orb orb-crimson"></div>
    <div class="anamorphic-glow-orb orb-blood"></div>
    <div class="anamorphic-glow-orb orb-mint"></div>
  </div>

  <slot />

  <script is:inline>
    // Inicialización del tema cinematográfico
    const savedTheme = localStorage.getItem('pm_theme_mode') || 'noche';
    document.documentElement.setAttribute('data-mode', savedTheme);
  </script>
</body>
</html>
